FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /bin/uv
COPY api/pyproject.toml api/uv.lock /app/
COPY api/agentops /app/agentops
COPY deploy/jockey /app/jockey
COPY clickhouse/migrations /app/clickhouse/migrations
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "agentops.app:app", "--host", "0.0.0.0", "--port", "8000"]
