# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
ARG PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV UV_DEFAULT_INDEX=${PYPI_INDEX_URL} UV_INDEX_URL=${PYPI_INDEX_URL}
RUN python -m pip install --no-cache-dir \
    --index-url "${PYPI_INDEX_URL}" \
    uv==0.8.22
COPY api/pyproject.toml api/uv.lock /app/
COPY api/agentops /app/agentops
COPY deploy/jockey /app/jockey
COPY clickhouse/migrations /app/clickhouse/migrations
RUN --mount=type=cache,id=agentops-uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev \
    --default-index "${PYPI_INDEX_URL}"
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "agentops.app:app", "--host", "0.0.0.0", "--port", "8000"]
