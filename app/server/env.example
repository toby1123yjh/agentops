# Copy to app/.env.server-mode. Never commit the filled file.
AGENTOPS_PUBLIC_URL=http://agentops.example.internal
AGENTOPS_LOCAL_EMAIL=admin@example.internal
AGENTOPS_LOCAL_PASSWORD=
AGENTOPS_PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
AGENTOPS_NPM_REGISTRY=https://registry.npmmirror.com
AGENTOPS_UV_CONCURRENT_DOWNLOADS=2
AGENTOPS_UV_HTTP_TIMEOUT=300
AGENTOPS_UV_HTTP_RETRIES=10

# AgentOps-managed PostgreSQL. It is isolated from cestc-claw's database.
POSTGRES_PORT=5432
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=<独立数据库密码>
POSTGRES_SSLMODE=prefer
POSTGRES_MIN_POOL_SIZE=1
POSTGRES_MAX_POOL_SIZE=5

CLICKHOUSE_PASSWORD=
CLICKHOUSE_TTL=4320h
AUTH_COOKIE_SECRET=
JWT_SECRET_KEY=

AGENTOPS_DASHBOARD_PORT=32170
AGENTOPS_API_PORT=32171
AGENTOPS_OTLP_PORT=32172
